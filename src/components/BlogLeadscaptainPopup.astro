---
// Popup banner shown only on blog inner pages. Asset and intent supplied by
// Stefan (public/leadscaptain_350x350_ad.gif). Dismissal persists for the
// session so returning readers are not nagged on every article.
// 2026-09-28 Stefan: bottom-right card instead of full-screen overlay so the
// content stays visible; closing the card also opens the link in a new tab.
---

<div
  id="lc-popup-card"
  class="pointer-events-auto fixed bottom-5 right-5 z-[100] hidden w-full max-w-[300px] translate-y-4 rounded-2xl border border-white/10 bg-gray-900 p-4 opacity-0 shadow-2xl shadow-brand-primary/20 transition-all duration-300"
  role="dialog"
  aria-label="LeadsCaptain promotion"
>
  <button
    id="lc-popup-close"
    type="button"
    aria-label="Close popup and open LeadsCaptain in a new tab"
    class="absolute right-2 top-2 flex h-7 w-7 items-center justify-center rounded-full bg-white/10 text-base leading-none text-white/70 transition-colors hover:bg-white/20 hover:text-white"
  >
    &times;
  </button>
  <a
    id="lc-popup-link"
    href="https://leadscaptain.com"
    target="_blank"
    rel="noopener sponsored"
    class="block"
  >
    <img
      src="/leadscaptain_350x350_ad.gif"
      alt="LeadsCaptain - find and reach your next customers"
      width="350"
      height="350"
      loading="lazy"
      class="mx-auto w-full rounded-xl"
    />
  </a>
  <p class="mt-3 text-center text-xs text-white/50">
    Sponsored by LeadsCaptain
  </p>
</div>

<script>
  const LC_POPUP_KEY = "lc-popup-dismissed";
  function lcTrack(eventName, params) {
    try {
      if (typeof window.gtag === "function") {
        window.gtag("event", eventName, params || {});
      }
    } catch {
      // analytics blocked - never break the popup
    }
  }
  const card = document.getElementById("lc-popup-card");
  const closeButton = document.getElementById("lc-popup-close");
  const link = document.getElementById("lc-popup-link");

  function lcHideCard() {
    if (!card) return;
    card.classList.remove("opacity-100", "translate-y-0");
    card.classList.add("opacity-0", "translate-y-4");
    window.setTimeout(() => {
      card.classList.add("hidden");
    }, 300);
    try {
      window.sessionStorage.setItem(LC_POPUP_KEY, "1");
    } catch {
      // storage unavailable - popup simply shows again next page
    }
  }

  function lcClosePopup() {
    // Stefan 2026-09-28: closing also opens the link in a new tab.
    lcTrack("leadscaptain_popup_close_click", {
      link_url: link?.href,
      page_path: window.location.pathname,
    });
    if (link) {
      window.open(link.href, "_blank", "noopener");
    }
    lcHideCard();
  }

  function lcMaybeOpenPopup() {
    if (!card) return;
    let dismissed = false;
    try {
      dismissed = window.sessionStorage.getItem(LC_POPUP_KEY) === "1";
    } catch {
      dismissed = false;
    }
    if (dismissed) return;
    card.classList.remove("hidden");
    requestAnimationFrame(() => {
      card.classList.remove("opacity-0", "translate-y-4");
      card.classList.add("opacity-100", "translate-y-0");
    });
    lcTrack("leadscaptain_popup_view", { page_path: window.location.pathname });
  }

  if (card) {
    window.setTimeout(lcMaybeOpenPopup, 3000);
    closeButton?.addEventListener("click", lcClosePopup);
    link?.addEventListener("click", () => {
      lcTrack("leadscaptain_popup_click", {
        link_url: link.href,
        page_path: window.location.pathname,
      });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !card.classList.contains("hidden")) {
        lcHideCard();
      }
    });
  }
</script>

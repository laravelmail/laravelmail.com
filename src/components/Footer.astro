---
import Brand from './marketing/Brand.astro';
import { getLangFromUrl } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = getLangFromUrl(Astro.url);
const url = (path: string) => getRelativeLocaleUrl(lang, path);
const groups = [
 {title:'Platform', links:[['Product','/product'],['Solutions','/solutions'],['Templates','/templates'],['Validation','/validation'],['Email Agent','/chat'],['Demo','/demo'],['Install','/early-access'],['Deploy','/deploy']]},
 {title:'Explore', links:[['Blog','/blog'],['Email Marketing','/email-marketing'],['Automation','/email-automation'],['Deliverability','/email-deliverability'],['Mailchimp Alternative','/mailchimp-alternative'],['KumoMTA','/kumomta'],['Careers','/careers'],['Contact','/contact']]},
 {title:'Legal', links:[['Privacy Policy','/privacy'],['Terms of Service','/terms-of-service'],['Cookie Policy','/cookie-policy']]},
];
---
<footer class="lm-footer">
 <div class="lm-shell">
  <div class="lm-footer-grid">
   <div><a href={url('/')} aria-label="Laravel Mail home"><Brand /></a><p class="lm-muted">Open-source email marketing.<br />Your infrastructure. Your control.</p>
    <address>7 High Street<br />Basildon, Essex<br />SS14 1AB, United Kingdom</address>
    <a href="tel:+447448218899">+44 744 821 8899</a><br /><a href="mailto:info@laravelmail.com">info@laravelmail.com</a>
   </div>
   {groups.map(g => <div><h2>{g.title}</h2><ul>{g.links.map(([label,path])=><li><a href={url(path)}>{label}</a></li>)}</ul></div>)}
  </div>
  <div class="lm-footer-bottom"><span>© {new Date().getFullYear()} Laravel Mail · <a href="https://laravelcompany.com">Laravel Company</a></span><div><a href="https://github.com/laravelmail">GitHub</a><a href="https://www.linkedin.com/company/laravelmail">LinkedIn</a><a href="/sitemap-index.xml">Sitemap</a></div></div>
  <nav class="lm-languages" aria-label="Language"><a href="/" lang="en">English</a><a href="/es" lang="es">Español</a><a href="/ru" lang="ru">Русский</a><a href="/zh" lang="zh">中文</a></nav>
 </div>
</footer>

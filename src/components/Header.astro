---
import Brand from './marketing/Brand.astro';
import { getLangFromUrl } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
const lang = getLangFromUrl(Astro.url);
const url = (path: string) => getRelativeLocaleUrl(lang, path);
const links = [['Product','/product'],['Solutions','/solutions'],['Templates','/templates'],['Validation','/validation'],['Email Agent','/chat'],['Blog','/blog']];
---
<header class="lm-header">
  <div class="lm-shell lm-nav">
    <a href={url('/')} aria-label="Laravel Mail home"><Brand /></a>
    <nav class="lm-desktop-nav" aria-label="Main navigation">
      {links.map(([label,path]) => <a href={url(path)} aria-current={Astro.url.pathname.replace(/\/$/,'') === url(path).replace(/\/$/,'') ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="lm-button lm-header-cta" href={url('/contact')}>Book a Demo <span aria-hidden="true">↗</span></a>
    <details class="lm-mobile-nav">
      <summary aria-label="Open navigation menu">Menu <span aria-hidden="true">☰</span></summary>
      <nav aria-label="Mobile navigation">{links.map(([label,path]) => <a href={url(path)}>{label}</a>)}<a href={url('/contact')}>Book a Demo</a></nav>
    </details>
  </div>
</header>

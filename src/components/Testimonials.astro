---
import TestimonialCard from "./Testimonials/TestimonialCard.astro";
import { testimonials } from "../data/testimonials";
---

<section class="py-24 bg-brand-bg-darker relative overflow-hidden" id="testimonials">
  <!-- Ambient Background Glows -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 -left-1/4 w-[600px] h-[600px] bg-brand-primary/10 blur-[150px] rounded-full animate-pulse"></div>
    <div class="absolute bottom-0 -right-1/4 w-[500px] h-[500px] bg-brand-accent/10 blur-[150px] rounded-full animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <div class="container-custom relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 animate-on-scroll">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm mb-6">
        <span class="w-2 h-2 rounded-full bg-brand-primary animate-pulse"></span>
        <span class="text-sm font-semibold text-gray-300">Customer Testimonials</span>
      </div>
      <h2
        class="text-4xl md:text-5xl font-black text-white mb-6 leading-tight"
        title="What our users are saying about Laravel Mail"
      >
        What our users are <span class="bg-gradient-to-r from-brand-primary via-purple-400 to-brand-accent bg-clip-text text-transparent">saying.</span>
      </h2>
      <p class="text-lg md:text-xl text-gray-400 leading-relaxed">
        See why developers and marketing teams worldwide choose Laravel Mail for their email infrastructure.
      </p>
    </div>

    <!-- Responsive Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {
        testimonials.map((testimonial, index) => (
          <TestimonialCard testimonial={testimonial} index={index} />
        ))
      }
    </div>
  </div>
</section>

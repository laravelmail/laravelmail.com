---
import {getRelativeLocaleUrl} from 'astro:i18n';
import {getLangFromUrl} from '../../i18n/utils';
const lang=getLangFromUrl(Astro.url);
const url=(path: string)=>getRelativeLocaleUrl(lang,path);
const products=[
 {name:'Email templates',eyebrow:'01 / DESIGN',body:'Start with a responsive template. Browse the library, preview the design and make it your own.',image:'templates',href:'/templates',cta:'Explore templates',alt:'Laravel Mail starter template library with announcement, newsletter and welcome designs'},
 {name:'Email validation',eyebrow:'02 / CHECK',body:'Inspect email syntax, domains and risk signals before a campaign. Review the verdict rather than treating any check as a delivery guarantee.',image:'validation',href:'/validation',cta:'Explore validation',alt:'Laravel Mail email validation screen with health status, address checker and domain lists'},
 {name:'AI email agent',eyebrow:'03 / WRITE',body:'Turn a campaign idea into a draft. Review the copy, audience and template before anything is sent.',image:'agent',href:'/chat',cta:'Try the email agent',alt:'Laravel Mail AI Email Agent interface explaining the draft and review flow'},
];
---
<section class="lm-section lm-home-hero">
 <div class="lm-shell lm-two-column">
  <div><span class="lm-eyebrow">OPEN SOURCE · SELF-HOSTED</span><h1><span class="lm-gradient">Email marketing.</span><br />Built for <span class="lm-gradient">ownership.</span></h1><p class="lm-lead">Campaigns, templates, validation and AI-assisted drafts. Built on Laravel, running on your infrastructure, with your audience under your control.</p><div class="lm-actions"><a class="lm-button" href={url('/contact')}>Book a Demo <span aria-hidden="true">→</span></a><a class="lm-button lm-button-outline" href="https://github.com/laravelmail/app.laravelmail.com">View source <span aria-hidden="true">↗</span></a></div><div class="lm-hero-notes"><span>◇ <b>Self-hosted</b><small>Your server, your data</small></span><span>✓ <b>Open source</b><small>Inspect and extend the code</small></span><span>↗ <b>Built on Laravel</b><small>Use the stack you know</small></span></div></div>
  <div class="lm-hero-product"><figure class="lm-product-frame"><img src="/screens/product/templates.webp" alt="Actual Laravel Mail starter templates in the QA workspace" width="1050" height="605" fetchpriority="high" /><figcaption>Inside Laravel Mail · actual product screenshot</figcaption></figure><div class="lm-feature-strip"><a href={url('/templates')}>Templates<span>Start with a design</span></a><a href={url('/validation')}>Validation<span>Check your list</span></a><a href={url('/chat')}>Email Agent<span>Draft, then review</span></a></div></div>
 </div>
</section>
<section class="lm-stack"><div class="lm-shell"><span>Built around your everyday stack</span><strong>Laravel</strong><strong>PHP</strong><strong>SMTP</strong><strong>Queues</strong><strong>Docker</strong></div></section>
<section class="lm-section" id="platform"><div class="lm-shell"><div class="lm-section-heading"><span class="lm-eyebrow">THE PLATFORM</span><h2>From first draft<br />to the <span class="lm-gradient">right inbox.</span></h2><p class="lm-muted">Connected tools for preparing, checking and sending email, without handing over your infrastructure.</p></div><div class="lm-product-grid">{products.map(p=><article class="lm-card"><a href={url(p.href)} class="lm-card-image"><img src={`/screens/product/${p.image}.webp`} alt={p.alt} width="1050" height="605" loading="lazy" /></a><div class="lm-card-body"><span class="lm-eyebrow">{p.eyebrow}</span><h3>{p.name}</h3><p>{p.body}</p><a class="lm-text-link" href={url(p.href)}>{p.cta} <span aria-hidden="true">→</span></a></div></article>)}</div></div></section>
<section class="lm-section lm-section-tinted"><div class="lm-shell"><div class="lm-section-heading"><span class="lm-eyebrow">HOW IT WORKS</span><h2>Your stack.<br /><span class="lm-gradient">Your sending workflow.</span></h2></div><div class="lm-process-grid">{[['01','Install & configure','Deploy the open-source application and connect an email service.','/deploy','Deployment guide'],['02','Prepare your audience','Import contacts, organise tags and build segments before selecting recipients.','/product','Explore the product'],['03','Review & send','Build a campaign, test your template and review the audience before dispatch.','/email-marketing','Campaign workflow']].map(([n,title,body,href,cta])=><article class="lm-process"><span>{n}</span><h3>{title}</h3><p>{body}</p><a class="lm-text-link" href={url(href)}>{cta} →</a></article>)}</div></div></section>
<section class="lm-section"><div class="lm-shell lm-two-column"><div><span class="lm-eyebrow">BUILT TO BE YOURS</span><h2>Keep the tools.<br /><span class="lm-gradient">Keep control.</span></h2><p class="lm-lead">Use the hosted interface to explore, or work with the code on your own server. Choose the setup that fits your team.</p><a class="lm-text-link" href={url('/solutions')}>Explore solutions →</a></div><div class="lm-benefits">{[['Data ownership','Keep your contact data in the infrastructure you choose.'],['A familiar foundation','Extend a Laravel codebase instead of starting from a closed platform.'],['Connected delivery','Configure your email service and review delivery reports in one place.']].map(([t,b])=><article><h3>{t}</h3><p>{b}</p></article>)}</div></div></section>
<section class="lm-section lm-section-tinted"><div class="lm-shell lm-two-column"><div><span class="lm-eyebrow">QUESTIONS</span><h2>Before you<br /><span class="lm-gradient">get started.</span></h2><a class="lm-text-link" href={url('/blog')}>Read the blog →</a></div><div class="lm-faq">{[['Is Laravel Mail open source?','Yes. The application source is available on GitHub. Self-hosting still needs infrastructure and an email delivery service.'],['Can I use my own email service?','The application includes email service configuration. Choose and configure a provider that supports your sending requirements.'],['Does the AI agent send automatically?','The campaign chat flow creates a draft for review. Check the content and audience before approving a send.'],['Where can I get setup help?','Read the deployment guide or book a demo to discuss your setup.']].map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
<section class="lm-section"><div class="lm-shell lm-cta-panel"><span class="lm-eyebrow">LET'S WALK THROUGH IT</span><h2>See Laravel Mail<br /><span class="lm-gradient">on your terms.</span></h2><p class="lm-lead">A conversation about the platform, your workflow and the setup you need.</p><div class="lm-actions"><a class="lm-button" href={url('/contact')}>Book a Demo →</a><a class="lm-button lm-button-outline" href={url('/early-access')}>Request Early Access</a></div><p class="lm-muted"><a href={url('/kumomta')}>KumoMTA integration</a> · <a href={url('/mailchimp-alternative')}>Mailchimp Alternative</a></p></div></section>

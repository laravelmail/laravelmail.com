---
import {getRelativeLocaleUrl} from 'astro:i18n';
import {getLangFromUrl} from '../../i18n/utils';
import PlatformShowcase from '../PlatformShowcase.astro';
const lang=getLangFromUrl(Astro.url);
const url=(path:string)=>getRelativeLocaleUrl(lang,path);
// Existing product destinations are retained. These are related products, not
// Laravel Mail features or an assertion that their logos are screenshots.
const products=[
 {name:'Laravel Social',category:'SOCIAL MEDIA',description:'A related Laravel product for planning and managing social content.',href:'https://laravelsocial.com',symbol:'S',tone:'violet'},
 {name:'Laravel Mail',category:'EMAIL MARKETING',description:'Prepare campaigns, work with templates and review your audience before sending.',href:'/',image:'/screens/product/templates.webp',tone:'violet'},
 {name:'Laravel SEO',category:'SEARCH',description:'Explore the related Laravel SEO product and its current offering.',href:'https://laravelseo.com',symbol:'SEO',tone:'pink'},
 {name:'Laravel GPT',category:'AI TOOLS',description:'Explore the related Laravel GPT product for AI-assisted workflows.',href:'https://laravelgpt.dev',symbol:'GPT',tone:'violet'},
 {name:'Laravel UI',category:'INTERFACE',description:'Explore the related Laravel UI product for interface development.',href:'https://laravelui.com',symbol:'UI',tone:'blue'},
 {name:'LeadsCaptain',category:'OUTREACH',description:'Explore the related LeadsCaptain product and its current offering.',href:'https://leadscaptain.com',symbol:'LC',tone:'green'},
];
---
<section class="lm-section lm-solutions-hero"><div class="lm-shell lm-two-column"><div><span class="lm-eyebrow">SOLUTIONS / BUILT ON LARAVEL</span><h1>Your workflow.<br /><span class="lm-gradient">Connected tools.</span></h1><p class="lm-lead">Email marketing for your own infrastructure. Explore Laravel Mail and related tools for your business.</p><div class="lm-actions"><a class="lm-button" href={url('/contact')}>Book a Demo →</a><a class="lm-button lm-button-outline" href={url('/product')}>Explore Laravel Mail ↗</a></div></div><figure class="lm-product-frame"><img src="/screens/product/validation.webp" width="1050" height="605" alt="Actual Laravel Mail validation interface with service health, address checker and domain lists"/><figcaption>Laravel Mail · actual product interface</figcaption></figure></div></section>
<section class="lm-section lm-section-tinted"><div class="lm-shell"><div class="lm-section-heading"><span class="lm-eyebrow">FIND YOUR WORKFLOW</span><h2>Built around<br /><span class="lm-gradient">your team.</span></h2></div><div class="lm-process-grid">{[['E-commerce','Organise customer lists and prepare relevant email campaigns.'],['SaaS & tech','Build welcome emails and product updates around your audience.'],['Agencies','Keep client work organised with separate workspaces.']].map(([name,description])=><article class="lm-process"><h3>{name}</h3><p>{description}</p><a class="lm-text-link" href={url('/contact')}>Discuss your setup →</a></article>)}</div></div></section>
<section class="lm-section"><div class="lm-shell"><div class="lm-section-heading"><span class="lm-eyebrow">THE LARAVEL PRODUCT FAMILY</span><h2>Tools with<br /><span class="lm-gradient">a shared foundation.</span></h2><p class="lm-muted">Start with Laravel Mail, or visit a related product to see its current features and terms.</p></div><div class="lm-family-grid">{products.map(p=><article class="lm-family-card"><div class={`lm-family-visual lm-family-${p.tone}`}>{p.image?<img src={p.image} alt="Laravel Mail starter template library" width="1050" height="605" loading="lazy"/>:<div class="lm-product-identity"><span aria-hidden="true">{p.symbol}</span><strong>{p.name}</strong></div>}</div><div class="lm-card-body"><span class="lm-eyebrow">{p.category}</span><h3>{p.name}</h3><p>{p.description}</p><a class="lm-text-link" href={p.href==='/'?url('/'):p.href} target={p.href.startsWith('https:')?'_blank':undefined} rel={p.href.startsWith('https:')?'noopener noreferrer':undefined}>Explore {p.name} ↗</a></div></article>)}</div></div></section>
<section class="lm-section lm-section-tinted"><div class="lm-shell"><div class="lm-section-heading"><span class="lm-eyebrow">YOUR INFRASTRUCTURE</span><h2>Keep control.<br /><span class="lm-gradient">Build on what you know.</span></h2></div><div class="lm-benefit-grid">{[['Self-hosted','Choose where your application and contact data live.'],['Open source','Inspect the application and adapt it to your workflow.'],['A familiar stack','Work with Laravel, queues and your email service.'],['Setup support','Book a walkthrough to discuss the setup you need.']].map(([name,description])=><article class="lm-tool-panel"><h3>{name}</h3><p class="lm-muted">{description}</p></article>)}</div></div></section>
<PlatformShowcase />
<section class="lm-section"><div class="lm-shell lm-cta-panel"><span class="lm-eyebrow">LET'S TALK</span><h2>Have a workflow<br /><span class="lm-gradient">in mind?</span></h2><p class="lm-lead">Walk through Laravel Mail and discuss your requirements.</p><div class="lm-actions"><a class="lm-button" href={url('/contact')}>Talk to Us →</a><a class="lm-button lm-button-outline" href={url('/')}>Back to Home</a></div></div></section>

---
import Layout from "../../layouts/Layout.astro";
import ChatContent from "../../components/ChatContent.astro";
import { languages } from "../../i18n/ui";

export async function getStaticPaths() {
  return Object.keys(languages)
    .filter((lang) => lang !== "en")
    .map((lang) => ({ params: { lang } }));
}

const title = "Free AI Email Generator: Write Professional Emails in Seconds";
const description = "Generate professional emails for free with our AI Email Writer. No login required. Perfect for sales, follow-ups, and business communication.";
const keywords = "free ai email generator, ai email writer, ai email generator, ai email writer free, write email with ai, professional email generator, ai email response generator, ai email assistant, business email generator, ai writing tool, email writer";
---

<Layout title={title} description={description} keywords={keywords} ogImage="/og-image.png">
  <ChatContent />
</Layout>

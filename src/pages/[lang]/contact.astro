---
import Layout from "../../layouts/Layout.astro";
import Booking from "../../components/marketing/Booking.astro";
import { languages } from '../../i18n/ui';
export async function getStaticPaths() {return Object.keys(languages).filter(lang=>lang!=='en').map(lang=>({params:{lang}}));}
---
<Layout title="Book a Demo | Contact Laravel Mail" description="Book a Laravel Mail demo or contact the team. Same company, same location, a closer look at the platform.">
 <section class="lm-section"><div class="lm-shell"><span class="lm-eyebrow">LET'S TALK</span><h1>Book a <span class="lm-gradient">Demo.</span></h1><p class="lm-lead">See the platform, talk through your workflow and ask about your setup. Choose a time in Calendly below.</p></div></section>
 <section class="lm-tool-section"><div class="lm-shell lm-contact-grid"><Booking /><aside class="lm-contact-details"><div class="rounded-2xl overflow-hidden shadow-xl bg-slate-800/80 border border-violet-500/20"><div class="w-full h-full flex flex-col"><div class="bg-gradient-to-r from-violet-600 to-pink-600 p-6 text-white"><h3 class="text-2xl font-bold mb-1">Hey there!</h3><p class="text-violet-100">We're here to help you take control of your email marketing - let's chat about your setup!</p></div><div class="p-6 space-y-6 flex-1"><div class="flex items-start space-x-4"><div class="shrink-0 w-10 h-10 bg-violet-500/20 rounded-full flex items-center justify-center mt-1"><svg class="w-5 h-5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg></div><div><h4 class="font-semibold text-white">Free &amp; Friendly Chat</h4><p class="text-slate-300 text-sm mt-1">30-minute call to get to know you and your email setup. No pressure, no hard sell!</p></div></div><div class="flex items-start space-x-4"><div class="shrink-0 w-10 h-10 bg-green-500/20 rounded-full flex items-center justify-center mt-1"><svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg></div><div><h4 class="font-semibold text-white">No Obligations</h4><p class="text-slate-300 text-sm mt-1">Totally pressure-free. Consider us your new friendly email infrastructure advisors!</p></div></div><div class="flex items-start space-x-4"><div class="shrink-0 w-10 h-10 bg-pink-500/20 rounded-full flex items-center justify-center mt-1"><svg class="w-5 h-5 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div><div><h4 class="font-semibold text-white">Actionable Ideas</h4><p class="text-slate-300 text-sm mt-1">Get practical suggestions you can use right away to improve your campaigns and deliverability.</p></div></div><div class="mt-8 p-4 bg-gradient-to-r from-violet-500/10 to-pink-500/10 rounded-lg border border-violet-500/20"><h4 class="font-semibold text-white mb-2">Let's Talk!</h4><p class="text-slate-300 text-sm mb-4">Book a quick chat and let's see how we can help you reach your goals.</p><a href="https://calendly.com/laravelagency/30min?utm_source=website&amp;utm_medium=general_inquiry&amp;utm_campaign=contact_page_cta" class="inline-block w-full bg-gradient-to-r from-violet-600 to-pink-600 hover:from-violet-500 hover:to-pink-500 text-white font-medium py-3 px-6 rounded-lg text-center transition-all duration-200 shadow-md hover:shadow-lg transform hover:-translate-y-1">Book Your Free Chat</a></div><p class="text-xs text-slate-400 mt-2 text-center">No sales pitch. Just a friendly 30-minute conversation.</p></div><div class="border-t border-slate-700/50 p-6 bg-slate-900/50"><h4 class="font-semibold text-white mb-3">Other Ways to Reach Us</h4><div class="space-y-2"><p class="text-slate-300"><span class="text-slate-400">Email:</span> <a href="mailto:info@laravelmail.com" class="text-violet-400 hover:text-violet-300 underline ml-1">info@laravelmail.com</a></p><p class="text-slate-300"><span class="text-slate-400">Phone:</span> <a href="tel:+447448218899" class="text-violet-400 hover:text-violet-300 underline ml-1">+44 744 821 8899</a></p><p class="text-slate-300"><span class="text-slate-400">Location:</span> <span class="ml-1">7 High Street, Basildon, Essex, SS14 1AB, United Kingdom</span></p><p class="text-slate-300"><span class="text-slate-400">Follow Us:</span></p><div class="flex gap-3 mt-2"><a href="https://github.com/laravelmail" class="w-9 h-9 flex items-center justify-center rounded-lg bg-slate-800 text-slate-400 hover:bg-violet-600 hover:text-white transition-all" aria-label="GitHub"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a></div></div></div></div></div></aside>
</div></section>
</Layout>

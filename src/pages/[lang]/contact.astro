---
import Layout from "../../layouts/Layout.astro";
import Booking from "../../components/marketing/Booking.astro";
import { languages } from '../../i18n/ui';
export async function getStaticPaths() {return Object.keys(languages).filter(lang=>lang!=='en').map(lang=>({params:{lang}}));}
---
<Layout title="Book a Demo | Contact Laravel Mail" description="Book a Laravel Mail demo or contact the team. Same company, same location, a closer look at the platform.">
 <section class="lm-section"><div class="lm-shell"><span class="lm-eyebrow">LET'S TALK</span><h1>Book a <span class="lm-gradient">Demo.</span></h1><p class="lm-lead">See the platform, talk through your workflow and ask about your setup. Choose a time in Calendly below.</p></div></section>
 <section class="lm-tool-section"><div class="lm-shell lm-contact-grid"><Booking /><aside class="lm-contact-details"><h2>Contact Laravel Mail</h2><p class="lm-muted">Prefer to get in touch directly?</p><p><a href="tel:+447448218899">+44 744 821 8899</a></p><p><a href="mailto:info@laravelmail.com">info@laravelmail.com</a></p><h2>Our location</h2><address>7 High Street<br />Basildon, Essex<br />SS14 1AB, United Kingdom</address><hr class="my-6 border-white/10" /><p class="lm-muted">A walkthrough of campaigns, templates, validation and the email agent. Bring your questions about self-hosting or your current email workflow.</p><a class="lm-text-link" href="https://github.com/laravelmail">Explore the source →</a></aside></div></section>
</Layout>

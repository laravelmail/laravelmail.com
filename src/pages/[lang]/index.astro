---
import Layout from "../../layouts/Layout.astro";
import Home from "../../components/marketing/Home.astro";
import { languages } from '../../i18n/ui';
export async function getStaticPaths() { return Object.keys(languages).filter(lang => lang !== 'en').map(lang => ({params:{lang}})); }

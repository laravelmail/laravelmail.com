---
import Layout from '../layouts/Layout.astro';
import ProductIntro from '../components/marketing/ProductIntro.astro';
const links=[['Template service','https://templates.laravelmail.com'],['Browse templates','https://templates.laravelmail.com/templates'],['Features','https://templates.laravelmail.com/features'],['Open Studio','https://templates.laravelmail.com/studio'],['Log in','https://templates.laravelmail.com/login'],['Create an account','https://templates.laravelmail.com/signup'],['Contact the template team','https://templates.laravelmail.com/contact']];
---
<Layout title="Laravel Email Templates | Laravel Mail" description="Explore email templates and the Laravel Mail template workflow.">
<ProductIntro eyebrow="DESIGN / EMAIL TEMPLATES" title="A considered start." accent="Your own message." description="Start with a template, adjust the content for your audience and preview the design before sending. The screenshot shows the built-in starter templates in Laravel Mail." image="/screens/product/templates.webp" alt="Laravel Mail starter template library showing announcement, newsletter and welcome designs" href="https://templates.laravelmail.com/templates" cta="Browse Templates" />
<section class="lm-section lm-section-tinted"><div class="lm-shell"><div class="lm-section-heading"><span class="lm-eyebrow">FROM IDEA TO EMAIL</span><h2>Design. Review.<br /><span class="lm-gradient">Make it yours.</span></h2></div><div class="lm-process-grid">{[['01','Choose a starting point','Explore the template library or the built-in starters shown above.'],['02','Add your message','Write for your audience and check any personalisation fields.'],['03','Preview before sending','Review your content, layout and recipients before dispatch.']].map(([n,t,b])=><article class="lm-process"><span>{n}</span><h3>{t}</h3><p>{b}</p></article>)}</div></div></section>
<section class="lm-section"><div class="lm-shell"><div class="lm-section-heading"><span class="lm-eyebrow">TEMPLATE RESOURCES</span><h2>Continue in<br /><span class="lm-gradient">the template service.</span></h2><p class="lm-muted">Visit the service for its current tools, account requirements and available templates.</p></div><div class="lm-benefit-grid">{links.map(([name,href])=><a class="lm-tool-panel lm-resource" href={href}><span>{name}</span><span aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="lm-section"><div class="lm-shell lm-cta-panel"><h2>See the<br /><span class="lm-gradient">whole workflow.</span></h2><p class="lm-lead">Book a walkthrough of templates, campaigns and validation in Laravel Mail.</p><div class="lm-actions"><a class="lm-button" href="/contact">Book a Demo →</a><a class="lm-button lm-button-outline" href="/templates">Explore Laravel Mail templates</a></div></div></section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ProductIntro from "../components/marketing/ProductIntro.astro";
import TemplateBrowser from "../components/templates/TemplateBrowser";
import { listTemplates, getIndustries, getMessageTypes } from "../lib/api/client";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const [{ templates: initialTemplates, total: initialTotal }, initialIndustries, initialMessageTypes] = await Promise.all([
  listTemplates({ page: 1, page_size: 12 }).catch(() => ({ templates: [], total: 0 })),
  getIndustries().catch(() => []),
  getMessageTypes().catch(() => []),
]);
---

<Layout
    title={t('templates.title')}
    description={t('templates.description')}
>
    <ProductIntro eyebrow="DESIGN / EMAIL TEMPLATES" title="A starting point" accent="for every email." description="Browse the template library, preview a design and adapt it for your next campaign. Keep your content and your sending workflow in one place." image="/screens/product/templates.webp" alt="Actual Laravel Mail starter template library" href="#template-library" cta="Browse the library" />
    <section class="lm-tool-section" id="template-library"><div class="lm-shell"><div class="lm-tool-panel"><h2 class="lm-tool-title">Template library</h2><p class="lm-muted mb-6">Search and filter designs, then open a template for a closer look.</p>
            <TemplateBrowser
                client:load
                initialTemplates={initialTemplates}
                initialTotal={initialTotal}
                initialIndustries={initialIndustries}
                initialMessageTypes={initialMessageTypes}
            />
    </div></div></section>
</Layout>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

---
import Layout from "../../layouts/Layout.astro";
import { listTemplates, getTemplateMeta } from "../../lib/api/client";
import type { TemplateMeta } from "../../lib/api/types";

export async function getStaticPaths() {
  const allTemplates: { slug: string; name: string }[] = [];
  let page = 1;
  let total = Infinity;
  while (allTemplates.length < total) {
    const data = await listTemplates({ page, page_size: 500 });
    for (const t of data.templates) {
      allTemplates.push({ slug: t.slug, name: t.name });
    }
    total = data.total;
    page++;
  }

  return allTemplates.map((t) => ({
    params: { slug: t.slug },
    props: { slug: t.slug, name: t.name },
  }));
}

interface Props {
  slug: string;
  name: string;
}

const { slug, name } = Astro.props;

let meta: TemplateMeta | null = null;
try {
  meta = await getTemplateMeta(slug);
} catch {}

const seoTitle = meta
  ? `${meta.name} - Email Template | Laravel Mail`
  : `${name} - Email Template | Laravel Mail`;
const seoDesc = meta?.description
  ? meta.description
  : `Professional ${name} email template. Browse our library of open-source email templates.`;
---

<Layout title={seoTitle} description={seoDesc}>
  <main class="min-h-screen pt-24 pb-16 bg-brand-bg-darker">
    <div class="container-custom">
      <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
        <a href="/templates" class="hover:text-white transition-colors">Templates</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
        <span class="text-white">{meta?.name || name}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <div class="bg-brand-bg-card/40 backdrop-blur-md rounded-2xl border border-white/10 overflow-hidden">
            <div class="aspect-[3/4] relative bg-gray-900/50 flex items-center justify-center">
              <iframe
                id="template-content"
                class="w-full h-full"
                title={meta?.name || name}
              />
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="bg-brand-bg-card/40 backdrop-blur-md rounded-2xl border border-white/10 p-6">
            <h1 class="text-2xl font-bold text-white mb-2">{meta?.name || name}</h1>
            {meta?.description && (
              <p class="text-gray-400 text-sm mb-4">{meta.description}</p>
            )}

            {meta && meta.industries.length > 0 && (
              <div class="mb-4">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Industries</h3>
                <div class="flex flex-wrap gap-2">
                  {meta.industries.map((ind) => (
                    <a
                      href={`/templates?industry=${encodeURIComponent(ind)}`}
                      class="px-3 py-1 bg-brand-primary/20 text-brand-primary text-xs font-bold rounded-full hover:bg-brand-primary/30 transition-all"
                    >
                      {ind}
                    </a>
                  ))}
                </div>
              </div>
            )}

            {meta && meta.message_types.length > 0 && (
              <div class="mb-4">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Message Types</h3>
                <div class="flex flex-wrap gap-2">
                  {meta.message_types.map((mt) => (
                    <a
                      href={`/templates?message_type=${encodeURIComponent(mt)}`}
                      class="px-3 py-1 bg-white/5 text-gray-300 text-xs rounded-full hover:bg-white/10 transition-all"
                    >
                      {mt}
                    </a>
                  ))}
                </div>
              </div>
            )}

            {meta && meta.tags.length > 0 && (
              <div class="mb-4">
                <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Tags</h3>
                <div class="flex flex-wrap gap-2">
                  {meta.tags.map((tag) => (
                    <span class="px-3 py-1 bg-white/5 text-gray-400 text-xs rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            )}

            <div class="mt-6 space-y-3">
              <a
                href={`https://github.com/laravelmail/${encodeURIComponent(slug)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center gap-2 px-4 py-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-white font-semibold transition-all"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0c-6.626 0-12 3.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                </svg>
                View on GitHub
              </a>
              <a
                href={`https://github.com/laravelmail/${encodeURIComponent(slug)}/generate`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex w-full items-center justify-center gap-2 px-4 py-3 bg-brand-primary/15 hover:bg-brand-primary/25 border border-brand-primary/30 rounded-xl text-brand-primary font-semibold transition-all"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m-7-7h14" />
                </svg>
                Use This Template
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  (async function () {
    const TEMPLATE_ORIGIN = "https://templates.laravelmail.com";
    const slug = window.location.pathname.split("/").filter(Boolean).pop();
    if (!slug) return;
    const iframe = document.getElementById("template-content") as HTMLIFrameElement | null;
    if (!iframe) return;

    iframe.src = `${TEMPLATE_ORIGIN}/templates/${encodeURIComponent(slug)}`;
  })();
</script>

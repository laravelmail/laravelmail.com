{
    "name": "laravelmail-com",
    "compatibility_date": "2026-01-20",
    "compatibility_flags": ["nodejs_compat"],
    "main": "./dist/_worker.js/index.js",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
    }
}
